# Server
PORT=8000
NODE_ENV=development

# Clerk (auth)
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Gemini LLM
GEMINI_API_KEY=your-gemini-api-key
GEMINI_DEFAULT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Sandbox
SANDBOX_PROVIDER=e2b
E2B_API_KEY=your-e2b-api-key

# CORS — in production set to your actual frontend domain, e.g. https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Frontend base URL (used for OAuth redirects back to the app)
FRONTEND_URL=http://localhost:3000

# Secret used to encrypt stored integration tokens at rest (set a strong, stable value)
INTEGRATION_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
